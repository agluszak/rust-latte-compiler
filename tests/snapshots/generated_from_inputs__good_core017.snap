b0:
  %v2 = xor i1 %0, true
  br i1 %v2, label %b2, label %b1

b1:                                               ; preds = %b0
  %v3 = icmp eq i1 %0, %1
  br label %b2

b2:                                               ; preds = %b1, %b0
  %v4 = phi i1 [ %v2, %b0 ], [ %v3, %b1 ]
  ret i1 %v4
}

define i32 @main() {
