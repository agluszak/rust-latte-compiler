b6:                                               ; preds = %b4
  %str_ptr = alloca [3 x i8], align 1
  store [3 x i8] c"apa", [3 x i8]* %str_ptr, align 1
  %str_ptr1 = bitcast [3 x i8]* %str_ptr to i8*
  %new_string = call %string* @newString(i8* %str_ptr1, i32 3)
  call void @printString(%string* %new_string)
  br label %b7

b7:                                               ; preds = %b6, %b5
  br i1 true, label %b9, label %b8

b8:                                               ; preds = %b7
  %dontCallMe = call i1 @dontCallMe(i32 1)
  br label %b9

b9:                                               ; preds = %b8, %b7
  %v18 = phi i1 [ true, %b7 ], [ %dontCallMe, %b8 ]
  call void @printBool(i1 %v18)
  br i1 false, label %b10, label %b11

b10:                                              ; preds = %b9
  %dontCallMe2 = call i1 @dontCallMe(i32 2)
  br label %b11

b11:                                              ; preds = %b10, %b9
  %v26 = phi i1 [ false, %b9 ], [ %dontCallMe2, %b10 ]
  call void @printBool(i1 %v26)
  br i1 true, label %b12, label %b13

b12:                                              ; preds = %b11
