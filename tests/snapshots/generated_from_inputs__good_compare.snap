---
source: tests/fixtures.rs
description: "// Author: Tomasz Wysocki 277696\nint main() {\n    if(1 <= 1)\n        printString(\"4\");\n    if(1 >= 1)\n        printString(\"4\");\n    if(1 > 1)\n        printString(\"5\");\n    if(1 < 1)\n        printString(\"5\");\n    if(1 < 2)\n        printString(\"6\");\n    if(2 > 1)\n        printString(\"6\");\n    if(1 > 2)\n        printString(\"7\");\n    if(2 < 1)\n        printString(\"7\");\n    return 0;\n}\n"
input_file: inputs/good/compare.lat
---
; ModuleID = 'compare'
source_filename = "compare"

%string = type { i8*, i32 }

@latte.str.0 = private constant [1 x i8] c"4"
@latte.str.1 = private constant [1 x i8] c"5"
@latte.str.2 = private constant [1 x i8] c"6"
@latte.str.3 = private constant [1 x i8] c"7"

declare void @printInt(i32)

declare void @printString(%string*)

declare void @error()

declare i32 @readInt()

declare %string* @readString()

declare %string* @newString(i8*, i32)

declare %string* @stringConcat(%string*, %string*)

declare i32 @stringEqual(%string*, %string*)

define i32 @main() {
b0:
  br i1 true, label %b1, label %b2

b1:                                               ; preds = %b0
  %new_string = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.0, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string)
  br label %b2

b2:                                               ; preds = %b1, %b0
  br i1 true, label %b3, label %b4

b3:                                               ; preds = %b2
  %new_string1 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.0, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string1)
  br label %b4

b4:                                               ; preds = %b3, %b2
  br i1 false, label %b5, label %b6

b5:                                               ; preds = %b4
  %new_string2 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.1, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string2)
  br label %b6

b6:                                               ; preds = %b5, %b4
  br i1 false, label %b7, label %b8

b7:                                               ; preds = %b6
  %new_string3 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.1, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string3)
  br label %b8

b8:                                               ; preds = %b7, %b6
  br i1 true, label %b9, label %b10

b9:                                               ; preds = %b8
  %new_string4 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.2, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string4)
  br label %b10

b10:                                              ; preds = %b9, %b8
  br i1 true, label %b11, label %b12

b11:                                              ; preds = %b10
  %new_string5 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.2, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string5)
  br label %b12

b12:                                              ; preds = %b11, %b10
  br i1 false, label %b13, label %b14

b13:                                              ; preds = %b12
  %new_string6 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.3, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string6)
  br label %b14

b14:                                              ; preds = %b13, %b12
  br i1 false, label %b15, label %b16

b15:                                              ; preds = %b14
  %new_string7 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.3, i32 0, i32 0), i32 1)
  call void @printString(%string* %new_string7)
  br label %b16

b16:                                              ; preds = %b15, %b14
  ret i32 0
}

