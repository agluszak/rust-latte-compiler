---
source: tests/fixtures.rs
description: "int main() {\n    printBool((left() && right()) == tail());\n    printPair(left() && right(), tail());\n    return 0;\n}\n\nboolean left() {\n    printString(\"left\");\n    return true;\n}\n\nboolean right() {\n    printString(\"right\");\n    return false;\n}\n\nboolean tail() {\n    printString(\"tail\");\n    return false;\n}\n\nvoid printBool(boolean value) {\n    if (value) {\n        printString(\"true\");\n    } else {\n        printString(\"false\");\n    }\n}\n\nvoid printPair(boolean first, boolean second) {\n    printBool(first);\n    printBool(second);\n}\n"
input_file: inputs/good/expression_cfg_sequencing.lat
---
; ModuleID = 'expression_cfg_sequencing'
source_filename = "expression_cfg_sequencing"

%string = type { i8*, i32 }

@latte.str.0 = private constant [4 x i8] c"left"
@latte.str.1 = private constant [5 x i8] c"false"
@latte.str.2 = private constant [4 x i8] c"true"
@latte.str.3 = private constant [5 x i8] c"right"
@latte.str.4 = private constant [4 x i8] c"tail"

declare void @printInt(i32)

declare void @printString(%string*)

declare void @error()

declare i32 @readInt()

declare %string* @readString()

declare %string* @newString(i8*, i32)

declare %string* @stringConcat(%string*, %string*)

declare i32 @stringEqual(%string*, %string*)

define i1 @latte_user_left() {
b0:
  %new_string = call %string* @newString(i8* getelementptr inbounds ([4 x i8], [4 x i8]* @latte.str.0, i32 0, i32 0), i32 4)
  call void @printString(%string* %new_string)
  ret i1 true
}

define i32 @main() {
b0:
  %latte_user_left = call i1 @latte_user_left()
  br i1 %latte_user_left, label %b1, label %b2

b1:                                               ; preds = %b0
  %latte_user_right = call i1 @latte_user_right()
  br label %b2

b2:                                               ; preds = %b1, %b0
  %v2 = phi i1 [ %latte_user_left, %b0 ], [ %latte_user_right, %b1 ]
  %latte_user_tail = call i1 @latte_user_tail()
  %v4 = icmp eq i1 %v2, %latte_user_tail
  call void @latte_user_printBool(i1 %v4)
  %latte_user_left1 = call i1 @latte_user_left()
  br i1 %latte_user_left1, label %b3, label %b4

b3:                                               ; preds = %b2
  %latte_user_right2 = call i1 @latte_user_right()
  br label %b4

b4:                                               ; preds = %b3, %b2
  %v8 = phi i1 [ %latte_user_left1, %b2 ], [ %latte_user_right2, %b3 ]
  %latte_user_tail3 = call i1 @latte_user_tail()
  call void @latte_user_printPair(i1 %v8, i1 %latte_user_tail3)
  ret i32 0
}

define void @latte_user_printBool(i1 %0) {
b0:
  br i1 %0, label %b1, label %b2

b2:                                               ; preds = %b0
  %new_string = call %string* @newString(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @latte.str.1, i32 0, i32 0), i32 5)
  call void @printString(%string* %new_string)
  br label %b3

b1:                                               ; preds = %b0
  %new_string1 = call %string* @newString(i8* getelementptr inbounds ([4 x i8], [4 x i8]* @latte.str.2, i32 0, i32 0), i32 4)
  call void @printString(%string* %new_string1)
  br label %b3

b3:                                               ; preds = %b1, %b2
  ret void
}

define void @latte_user_printPair(i1 %0, i1 %1) {
b0:
  call void @latte_user_printBool(i1 %0)
  call void @latte_user_printBool(i1 %1)
  ret void
}

define i1 @latte_user_right() {
b0:
  %new_string = call %string* @newString(i8* getelementptr inbounds ([5 x i8], [5 x i8]* @latte.str.3, i32 0, i32 0), i32 5)
  call void @printString(%string* %new_string)
  ret i1 false
}

define i1 @latte_user_tail() {
b0:
  %new_string = call %string* @newString(i8* getelementptr inbounds ([4 x i8], [4 x i8]* @latte.str.4, i32 0, i32 0), i32 4)
  call void @printString(%string* %new_string)
  ret i1 false
}

