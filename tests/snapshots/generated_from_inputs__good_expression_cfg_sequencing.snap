---
source: tests/fixtures.rs
description: "int main() {\n    printBool((left() && right()) == tail());\n    printPair(left() && right(), tail());\n    return 0;\n}\n\nboolean left() {\n    printString(\"left\");\n    return true;\n}\n\nboolean right() {\n    printString(\"right\");\n    return false;\n}\n\nboolean tail() {\n    printString(\"tail\");\n    return false;\n}\n\nvoid printBool(boolean value) {\n    if (value) {\n        printString(\"true\");\n    } else {\n        printString(\"false\");\n    }\n}\n\nvoid printPair(boolean first, boolean second) {\n    printBool(first);\n    printBool(second);\n}\n"
input_file: inputs/good/expression_cfg_sequencing.lat
---
; ModuleID = 'expression_cfg_sequencing'
source_filename = "expression_cfg_sequencing"

%string = type { i8*, i32 }

declare void @printInt(i32)

declare void @printString(%string*)

declare i32 @readInt()

declare %string* @readString()

declare void @error()

declare %string* @newString(i8*, i32)

declare %string* @stringConcat(%string*, %string*)

declare i32 @stringEqual(%string*, %string*)

define i1 @left() {
b0:
  %str_ptr = alloca [4 x i8], align 1
  store [4 x i8] c"left", [4 x i8]* %str_ptr, align 1
  %str_ptr1 = bitcast [4 x i8]* %str_ptr to i8*
  %new_string = call %string* @newString(i8* %str_ptr1, i32 4)
  call void @printString(%string* %new_string)
  ret i1 true
}

define i32 @main() {
b0:
  %left = call i1 @left()
  br i1 %left, label %b1, label %b2

b1:                                               ; preds = %b0
  %right = call i1 @right()
  br label %b2

b2:                                               ; preds = %b1, %b0
  %v2 = phi i1 [ %left, %b0 ], [ %right, %b1 ]
  %tail = call i1 @tail()
  %v4 = icmp eq i1 %v2, %tail
  call void @printBool(i1 %v4)
  %left1 = call i1 @left()
  br i1 %left1, label %b3, label %b4

b3:                                               ; preds = %b2
  %right2 = call i1 @right()
  br label %b4

b4:                                               ; preds = %b3, %b2
  %v8 = phi i1 [ %left1, %b2 ], [ %right2, %b3 ]
  %tail3 = call i1 @tail()
  call void @printPair(i1 %v8, i1 %tail3)
  ret i32 0
}

define void @printBool(i1 %0) {
b0:
  br i1 %0, label %b1, label %b2

b1:                                               ; preds = %b0
  %str_ptr = alloca [4 x i8], align 1
  store [4 x i8] c"true", [4 x i8]* %str_ptr, align 1
  %str_ptr1 = bitcast [4 x i8]* %str_ptr to i8*
  %new_string = call %string* @newString(i8* %str_ptr1, i32 4)
  call void @printString(%string* %new_string)
  br label %b3

b2:                                               ; preds = %b0
  %str_ptr2 = alloca [5 x i8], align 1
  store [5 x i8] c"false", [5 x i8]* %str_ptr2, align 1
  %str_ptr3 = bitcast [5 x i8]* %str_ptr2 to i8*
  %new_string4 = call %string* @newString(i8* %str_ptr3, i32 5)
  call void @printString(%string* %new_string4)
  br label %b3

b3:                                               ; preds = %b2, %b1
  ret void
}

define void @printPair(i1 %0, i1 %1) {
b0:
  call void @printBool(i1 %0)
  call void @printBool(i1 %1)
  ret void
}

define i1 @right() {
b0:
  %str_ptr = alloca [5 x i8], align 1
  store [5 x i8] c"right", [5 x i8]* %str_ptr, align 1
  %str_ptr1 = bitcast [5 x i8]* %str_ptr to i8*
  %new_string = call %string* @newString(i8* %str_ptr1, i32 5)
  call void @printString(%string* %new_string)
  ret i1 false
}

define i1 @tail() {
b0:
  %str_ptr = alloca [4 x i8], align 1
  store [4 x i8] c"tail", [4 x i8]* %str_ptr, align 1
  %str_ptr1 = bitcast [4 x i8]* %str_ptr to i8*
  %new_string = call %string* @newString(i8* %str_ptr1, i32 4)
  call void @printString(%string* %new_string)
  ret i1 false
}
