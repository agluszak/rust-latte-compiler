---
source: tests/fixtures.rs
description: "// Author: Tomasz Wysocki 277696\nint main() {\n    printString(\"a\" + \"b\");\n    return 0;\n}\n"
input_file: inputs/good/concatenation.lat
---
; ModuleID = 'concatenation'
source_filename = "concatenation"

%string = type { i8*, i32 }

@latte.str.0 = private constant [1 x i8] c"a"
@latte.str.1 = private constant [1 x i8] c"b"

declare void @printInt(i32)

declare void @printString(%string*)

declare void @error()

declare i32 @readInt()

declare %string* @readString()

declare %string* @newString(i8*, i32)

declare %string* @stringConcat(%string*, %string*)

declare i32 @stringEqual(%string*, %string*)

define i32 @main() {
b0:
  %new_string = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.0, i32 0, i32 0), i32 1)
  %new_string1 = call %string* @newString(i8* getelementptr inbounds ([1 x i8], [1 x i8]* @latte.str.1, i32 0, i32 0), i32 1)
  %new_string2 = call %string* @stringConcat(%string* %new_string, %string* %new_string1)
  call void @printString(%string* %new_string2)
  ret i32 0
}

