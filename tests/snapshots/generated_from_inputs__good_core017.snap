b3:                                               ; preds = %b2
  br label %b4

b4:                                               ; preds = %b3, %b2
  %v8 = phi i1 [ %v6, %b2 ], [ true, %b3 ]
  br i1 %v8, label %b5, label %b6

b5:                                               ; preds = %b4
  call void @printBool(i1 true)
