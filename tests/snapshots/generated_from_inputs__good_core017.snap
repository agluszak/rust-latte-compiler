b14:                                              ; preds = %b13
  br label %b15

b15:                                              ; preds = %b14, %b13
  %v41 = phi i1 [ %v39, %b13 ], [ true, %b14 ]
  call void @printBool(i1 %v41)
  %implies = call i1 @implies(i1 false, i1 false)
